#!/bin/sh
# Gradle wrapper script
APP_NAME="Gradle"
APP_HOME="$(cd "$(dirname "$0")" && pwd)"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
WRAPPER_PROPERTIES="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

# Extract distribution URL from properties
DIST_URL=$(grep distributionUrl "$WRAPPER_PROPERTIES" | sed 's/.*=//' | sed 's/\\//g')
ZIP_NAME=$(basename "$DIST_URL")
GRADLE_VERSION=$(echo "$ZIP_NAME" | sed 's/gradle-//' | sed 's/-bin.zip//')
INSTALL_DIR="$GRADLE_USER_HOME/wrapper/dists/gradle-${GRADLE_VERSION}-bin"

if [ ! -f "$INSTALL_DIR/gradle-${GRADLE_VERSION}/bin/gradle" ]; then
    mkdir -p "$INSTALL_DIR"
    echo "Downloading Gradle $GRADLE_VERSION..."
    curl -L -o "$INSTALL_DIR/$ZIP_NAME" "$DIST_URL"
    unzip -q "$INSTALL_DIR/$ZIP_NAME" -d "$INSTALL_DIR"
fi

exec "$INSTALL_DIR/gradle-${GRADLE_VERSION}/bin/gradle" "$@"
